{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brio-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "61421001", "simple": { "limit": 30, "period": 60 } },
    { "name": "ENTRY_LIMITER", "namespace_id": "61421002", "simple": { "limit": 1200, "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "61421003", "simple": { "limit": 60, "period": 60 } },
    { "name": "CLIENT_LIMITER", "namespace_id": "61421004", "simple": { "limit": 30, "period": 10 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brio-db",
      "database_id": "fcf6442e-ead1-4136-9660-21ab5206df3a"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoomDO"
      },
      {
        "name": "REQUEST_LIMITER",
        "class_name": "RequestLimiterDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoomDO"]
    },
    {
      "tag": "v2-request-limiter",
      "new_sqlite_classes": ["RequestLimiterDO"]
    }
  ]
}

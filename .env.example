# Brio Environment Variables Example (Local Development)
# DO NOT COMMIT SECRETS OR CREDENTIALS

# Cloudflare Worker / API Configuration
NODE_ENV=development
API_BASE_URL=http://localhost:8787

# Google OAuth (Creator Login - Local Mock Verification Guard)
# Set GOOGLE_CLIENT_ID to your Google OAuth client ID for testing
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
DEV_AUTH_BYPASS=true

# Cloudinary Media Configuration (Placeholders)
CLOUDINARY_CLOUD_NAME=local-brio-demo
CLOUDINARY_API_KEY=1234567890

# Optional Local HTTP Port
PORT=8787

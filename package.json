{
  "name": "brio-monorepo",
  "private": true,
  "scripts": {
    "lan:package": "node scripts/lan-package.mjs",
    "lan:build": "node scripts/lan-build.mjs",
    "lan:start": "pnpm --filter @brio/local start",
    "dev": "pnpm --parallel --filter @brio/web --filter @brio/worker dev",
    "build": "pnpm --filter @brio/contracts build && pnpm --filter @brio/game-core build && pnpm --filter @brio/web build && pnpm --filter @brio/worker build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test",
    "db:migrate:local": "pnpm --filter @brio/worker db:migrate:local",
    "architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\" \"scripts/*.mjs\" \"benchmarks/*.ts\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\" \"scripts/*.mjs\" \"benchmarks/*.ts\"",
    "quality": "node scripts/verify.mjs",
    "performance": "node --import tsx scripts/performance.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
